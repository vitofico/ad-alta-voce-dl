# ============================================
# ProtonVPN (OpenVPN) — default configuration
# ============================================
# Get credentials from: https://account.protonvpn.com/account#openvpn
VPN_SERVICE_PROVIDER=protonvpn
VPN_TYPE=openvpn
OPENVPN_USER=
OPENVPN_PASSWORD=
SERVER_COUNTRIES=Italy

# ============================================
# NordVPN (OpenVPN)
# ============================================
# Get service credentials from: https://my.nordaccount.com/dashboard/nordvpn/manual-configuration/
# VPN_SERVICE_PROVIDER=nordvpn
# VPN_TYPE=openvpn
# OPENVPN_USER=
# OPENVPN_PASSWORD=
# SERVER_COUNTRIES=Italy

# ============================================
# Poller schedule
# ============================================
# How often to check for new episodes. Values: 30m, 1h, 6h, 1d, 7d
# Default: 1d (once daily)
POLL_INTERVAL=1d

# ============================================
# Custom WireGuard (Oracle Cloud, etc.)
# ============================================
# To switch to Oracle, change docker-compose.yml environment section
# and set these values from your .conf file:
#
# VPN_SERVICE_PROVIDER=custom
# VPN_TYPE=wireguard
# VPN_ENDPOINT_IP=
# VPN_ENDPOINT_PORT=51820
# WIREGUARD_PUBLIC_KEY=     # [Peer] PublicKey
# WIREGUARD_PRIVATE_KEY=    # [Interface] PrivateKey
# WIREGUARD_ADDRESSES=      # [Interface] Address
