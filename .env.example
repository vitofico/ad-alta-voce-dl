# Copy to .env and fill in. .env is gitignored: keep real credentials out of git.
# Everything here has a working default except the VPN credentials.

# ============================================
# VPN (gluetun sidecar)
# ============================================
# RAI serves this content to Italian IP addresses only, so the default stack
# routes the downloader through gluetun. Use the *service* credentials your
# provider issues for manual configuration, not your account login.
#
# ProtonVPN: https://account.protonvpn.com/account#openvpn
VPN_SERVICE_PROVIDER=protonvpn
VPN_TYPE=openvpn
OPENVPN_USER=
OPENVPN_PASSWORD=
SERVER_COUNTRIES=Italy

# NordVPN: https://my.nordaccount.com/dashboard/nordvpn/manual-configuration/
# VPN_SERVICE_PROVIDER=nordvpn
# VPN_TYPE=openvpn
# OPENVPN_USER=
# OPENVPN_PASSWORD=
# SERVER_COUNTRIES=Italy

# Custom WireGuard (Oracle Cloud and friends). Take these from your .conf file
# and add them to gluetun's environment in docker-compose.yml.
# VPN_SERVICE_PROVIDER=custom
# VPN_TYPE=wireguard
# VPN_ENDPOINT_IP=
# VPN_ENDPOINT_PORT=51820
# WIREGUARD_PUBLIC_KEY=     # [Peer] PublicKey
# WIREGUARD_PRIVATE_KEY=    # [Interface] PrivateKey
# WIREGUARD_ADDRESSES=      # [Interface] Address

# ============================================
# Storage
# ============================================
# Host directory that gets mounted as the library. Point it at your
# Audiobookshelf library and finished books land there directly.
AUDIOBOOKS_DIR=./downloads

# ============================================
# Exposure
# ============================================
# Which host address publishes the web UI. The default reaches the whole LAN,
# which is usually what you want on a NAS. The UI has no authentication, so set
# this to 127.0.0.1 if the machine is shared or on an untrusted network.
# WEB_BIND_ADDR=0.0.0.0

# Which host address publishes gluetun's HTTP proxy. Loopback by default:
# an open proxy lets anyone who reaches it use your VPN account.
# PROXY_BIND_ADDR=127.0.0.1

# ============================================
# Permissions
# ============================================
# UID/GID the container runs as. It must be able to write AUDIOBOOKS_DIR.
# On Linux, `id -u` and `id -g` give you yours. Set both to 0 to run as root,
# which is what versions before 2026.08 did.
# PUID=1000
# PGID=1000

# ============================================
# Running outside Docker
# ============================================
# Only relevant for `make run` / `uv run`, not for the containers.
#
# Where the app writes and reads audiobooks, and where the poller keeps its
# progress file. Inside Docker these are set by docker-compose.yml.
# DOWNLOADS_DIR=/audiobooks
# POLLER_STATE_DIR=/state
#
# Proxy for RAI requests, honoured by rai/core.py. With the stack running you
# can borrow gluetun's Italian exit: HTTP_PROXY=http://127.0.0.1:8888
# HTTP_PROXY=
# HTTPS_PROXY=

# There is no POLL_INTERVAL. The poller runs one cycle and exits, so the
# schedule lives outside the app: trigger it from the UI, from
# POST /api/v1/system/poll, or from cron. See the README.
